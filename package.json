{
  "name": "quentagon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write app components data lib tests scripts *.ts *.mjs *.json README.md",
    "format:check": "prettier --check app components data lib tests scripts *.ts *.mjs *.json README.md",
    "audit:performance": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "motion": "13.4.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
